# Settings for the account service. Copy to /etc/codlegacy/accounts.env and edit.
# The service reads these from its environment (the systemd unit loads this file).

# Where it listens. Keep it on localhost and let the web server (Caddy) face the internet.
ACCOUNTS_BIND=127.0.0.1:8080

# The address players reach it at. Must be https for a real server. Steam sends the
# browser back here after sign-in.
ACCOUNTS_PUBLIC_URL=https://codlegacy.example.com

# The database file (SQLite). Back this file up.
ACCOUNTS_DB=/var/lib/codlegacy/accounts.sqlite

# Serve the website from the same service (one domain, no extra hosting needed).
ACCOUNTS_STATIC_DIR=/opt/codlegacy/web

# The header the web server sets to the real client address. Only set this when a proxy
# in front overwrites it (the Caddyfile here does). Without it, rate limits see the
# proxy's address for everyone.
ACCOUNTS_TRUST_IP_HEADER=X-Real-IP

# Game servers allowed to confirm join tickets and report matches: name:key, comma
# separated, each key at least 24 random characters. Make one per game server, for
# example:  openssl rand -hex 24
ACCOUNTS_SERVER_KEYS=eu1:replace-with-a-long-random-string
# Key for the /admin/* routes (answer tickets, ban, create leagues). Send as X-Admin-Key. Leave unset to disable.
ACCOUNTS_ADMIN_KEY=replace-with-another-long-random-string

# Only if the website is hosted somewhere else (for example Cloudflare Pages): the
# site's address, so its pages may call this service and sign-in may return to it.
#ACCOUNTS_ALLOWED_ORIGINS=https://codlegacy.pages.dev

# Days a website sign-in lasts.
#ACCOUNTS_SESSION_DAYS=30
